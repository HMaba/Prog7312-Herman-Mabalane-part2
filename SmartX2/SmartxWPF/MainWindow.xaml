<Window x:Class="SmartxWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Smart-X | IoT Operations" Height="900" Width="1450" MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="#F3F6FA">
    <Window.Resources>
        <SolidColorBrush x:Key="Navy" Color="#132238"/>
        <SolidColorBrush x:Key="Blue" Color="#246BFD"/>
        <SolidColorBrush x:Key="Muted" Color="#66758A"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#246BFD"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderBrush" Value="#D6DEE8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="36"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4EAF1"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid">
      <Grid x:Name="WorkspaceGrid" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="225"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource Navy}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,25,18,25">
                    <Border Width="44" Height="44" CornerRadius="12" Background="#246BFD" HorizontalAlignment="Left">
                        <TextBlock Text="S-X" Foreground="White" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="SMART-X" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,13,0,2"/>
                    <TextBlock Text="IoT OPERATIONS PLATFORM" Foreground="#A8B7CC" FontSize="10" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="#8192AA" FontSize="10" FontWeight="Bold" Margin="22,0,0,10"/>
                    <Button x:Name="DashboardNav" Content="  Overview" HorizontalContentAlignment="Left" Background="#263A55" Click="DashboardNav_Click"/>
                    <Button Content="  Sensor telemetry" HorizontalContentAlignment="Left" Background="Transparent" Click="TelemetryNav_Click"/>
                    <Button Content="  Command stream" HorizontalContentAlignment="Left" Background="Transparent" Click="CommandNav_Click"/>
                    <Button Content="  Network topology" HorizontalContentAlignment="Left" Background="Transparent" IsEnabled="False" Foreground="#78869A"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="16">
                    <Border Background="#1D3049" CornerRadius="9" Padding="12">
                        <StackPanel>
                            <TextBlock Text="API CONNECTION" Foreground="#A8B7CC" FontSize="10" FontWeight="Bold"/>
                            <TextBlock x:Name="ConnectionStatus" Text="Not connected" Foreground="#FFD166" FontSize="12" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Smart-X • .NET 10" Foreground="#8192AA" FontSize="11" Margin="4,13,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="27">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Operations overview" FontSize="27" FontWeight="Bold" Foreground="#172B4D"/>
                    <TextBlock Text="Monitor connected devices, telemetry health and operator actions." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Import device list" Background="#0F766E" Click="ImportDevices_Click"/><Button Content="Refresh data" Click="Refresh_Click"/>
                    <Button Content="Sign out" Background="#172B4D" Click="SignOut_Click"/>
                </StackPanel>
            </Grid>
            <Border x:Name="ConnectionPanel" Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="API base URL" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBox x:Name="ApiUrlBox" Text="http://localhost:5234" Margin="0,3,8,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Firebase email" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <TextBox x:Name="EmailBox" Margin="3,3,8,0" Padding="9,7" BorderBrush="#D6DEE8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Firebase password" Foreground="{StaticResource Muted}" FontSize="11"/>
                        <PasswordBox x:Name="PasswordBox" Margin="3,3,8,0" Padding="9,7" BorderBrush="#D6DEE8"/>
                    </StackPanel>
                    <Button Grid.Column="3" Content="Sign in &amp; connect" VerticalAlignment="Bottom" Click="ApplyConnection_Click"/>
                </Grid>
            </Border>
            <TabControl x:Name="MainTabs" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged">
                <TabItem Header="Overview">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,15,0,0">
                            <UniformGrid Columns="4" Margin="0,0,0,18">
                                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel><TextBlock Text="REGISTERED DEVICES" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DeviceCount" Text="—" FontSize="30" FontWeight="Bold" Foreground="#172B4D" Margin="0,7,0,0"/><TextBlock Text="From command-stream API" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel><TextBlock Text="ACTIVE ALERTS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="AlertCount" Text="—" FontSize="30" FontWeight="Bold" Foreground="#D9485F" Margin="0,7,0,0"/><TextBlock Text="Requires operator attention" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel><TextBlock Text="PACKETS PROCESSED" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="PacketCount" Text="—" FontSize="30" FontWeight="Bold" Foreground="#172B4D" Margin="0,7,0,0"/><TextBlock Text="Telemetry processing count" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                </Border>
                                <Border Background="White" CornerRadius="10" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel><TextBlock Text="DISCONNECTED" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="DisconnectedCount" Text="—" FontSize="30" FontWeight="Bold" Foreground="#D97706" Margin="0,7,0,0"/><TextBlock Text="Offline nodes" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
                                </Border>
                            </UniformGrid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,10,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel><TextBlock Text="Device status" FontSize="16" FontWeight="Bold" Foreground="#172B4D" Margin="0,0,0,12"/>
                                        <DataGrid x:Name="OverviewDevices" Height="310">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Device" Binding="{Binding DeviceIdentifier}" Width="*"/>
                                                <DataGridTextColumn Header="Node" Binding="{Binding NodeId}" Width="*"/>
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                                <DataGridTextColumn Header="Alert state" Binding="{Binding AlertState}" Width="110"/>
                                                <DataGridTextColumn Header="Packets" Binding="{Binding PacketsReceived}" Width="75"/>
                                                <DataGridTextColumn Header="Latest readings" Binding="{Binding Readings}" Width="2*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel><TextBlock Text="Automated insights" FontSize="16" FontWeight="Bold" Foreground="#172B4D" Margin="0,0,0,12"/>
                                        <ListBox x:Name="OverviewInsights" BorderThickness="0" Background="Transparent" MinHeight="310" DisplayMemberPath="Message"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Sensor telemetry">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="White" CornerRadius="10" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
                            <DockPanel><TextBlock Text="Filter devices" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/><Button DockPanel.Dock="Right" Content="Search API" Click="Search_Click"/><TextBox x:Name="SearchBox" MinWidth="250" DockPanel.Dock="Left" ToolTip="Device name, node, MAC, or category"/></DockPanel>
                        </Border>
                        <DataGrid x:Name="TelemetryDevices" Grid.Row="1" Margin="0,0,0,10" SelectionChanged="TelemetryDevices_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding DeviceId}" Width="55"/>
                                <DataGridTextColumn Header="Device" Binding="{Binding DeviceIdentifier}" Width="*"/>
                                <DataGridTextColumn Header="MAC address" Binding="{Binding MacAddress}" Width="150"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="140"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Alert" Binding="{Binding AlertState}" Width="100"/>
                                <DataGridTextColumn Header="Packets" Binding="{Binding PacketsReceived}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Selected device sensor readings / timeline" FontWeight="Bold" Foreground="#172B4D" Margin="2,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <DataGrid x:Name="TelemetrySensors" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="0,0,5,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Sensor" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                                            <DataGridTextColumn Header="Latest value" Binding="{Binding Value}" Width="*"/>
                                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="65"/>
                                            <DataGridCheckBoxColumn Header="Out of range" Binding="{Binding IsOutOfRange}" Width="95"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <DataGrid x:Name="TelemetryTimeline" Grid.Column="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Margin="5,0,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Timestamp" Binding="{Binding Timestamp}" Width="*"/>
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                            <DataGridTextColumn Header="Numeric" Binding="{Binding Numeric}" Width="90"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Command stream">
                    <Grid Margin="0,15,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="White" CornerRadius="10" Padding="12" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,12">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Selected device ID:" VerticalAlignment="Center" Margin="3"/>
                                <TextBox x:Name="CommandDeviceId" Width="90" Text="1"/>
                                <TextBlock Text="Sensor ID (optional):" VerticalAlignment="Center" Margin="3"/>
                                <TextBox x:Name="CommandSensorId" Width="90"/>
                                <Button Content="Turn on" Click="TurnOn_Click"/>
                                <Button Content="Turn off" Click="TurnOff_Click" Background="#475569"/>
                                <Button Content="Toggle" Click="Toggle_Click" Background="#0F766E"/>
                                <Button Content="Undo last command" Click="Undo_Click" Background="#B45309"/>
                                <Button Content="Load history" Click="History_Click" Background="#172B4D"/>
                            </WrapPanel>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel><TextBlock Text="Recent alerts" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/><DataGrid x:Name="AlertsGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="85"/>
                                        <DataGridTextColumn Header="Device" Binding="{Binding DeviceIdentifier}" Width="*"/>
                                        <DataGridTextColumn Header="Alert" Binding="{Binding AlertType}" Width="150"/>
                                        <DataGridTextColumn Header="Details" Binding="{Binding Message}" Width="2*"/>
                                        <DataGridTextColumn Header="Raised" Binding="{Binding RaisedAt}" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid></StackPanel>
                            </Border>
                            <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14" Margin="0,8,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                                <StackPanel><TextBlock Text="Command history" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/><DataGrid x:Name="HistoryGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Device" Binding="{Binding DeviceIdentifier}" Width="*"/>
                                        <DataGridTextColumn Header="Sensor" Binding="{Binding SensorName}" Width="*"/>
                                        <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="110"/>
                                        <DataGridTextColumn Header="New state" Binding="{Binding NewState}" Width="90"/>
                                        <DataGridTextColumn Header="Issued at" Binding="{Binding IssuedAt}" Width="170"/>
                                        <DataGridCheckBoxColumn Header="Undone" Binding="{Binding Undone}" Width="75"/>
                                    </DataGrid.Columns>
                                </DataGrid></StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
            <Border Grid.Row="3" Background="#E8EEF6" CornerRadius="7" Padding="10" Margin="0,14,0,0">
                <TextBlock x:Name="StatusMessage" Text="Enter your API URL and a valid Firebase ID token, then apply the connection." Foreground="#334155" TextWrapping="Wrap"/>
            </Border>
        </Grid>
      </Grid>

      <!-- Welcome / splash screen: shown first at startup -->
      <Grid x:Name="SplashPanel" Background="#101D30">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.1*"/>
          <ColumnDefinition Width="0.9*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="72,40,24,40">
          <Border Background="#246BFD" CornerRadius="13" Width="62" Height="62" HorizontalAlignment="Left" Margin="0,0,0,26">
            <TextBlock Text="S-X" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="SMART-X" Foreground="White" FontSize="18" FontWeight="Bold"/>
          <TextBlock Text="INTELLIGENT IOT OPERATIONS" Foreground="#8EA4C2" FontSize="11" FontWeight="SemiBold" Margin="0,8,0,24"/>
          <TextBlock Text="See your connected world&#10;in a smarter way." Foreground="White" FontSize="42" FontWeight="Bold" TextWrapping="Wrap" LineHeight="50"/>
          <TextBlock Text="A unified workspace for device telemetry, real-time command streams, alerts and automated insights." Foreground="#B5C3D6" FontSize="16" TextWrapping="Wrap" MaxWidth="570" Margin="0,22,0,30" LineHeight="25"/>
          <Button Content="Enter Smart-X  →" Width="190" Height="48" HorizontalAlignment="Left" Background="#246BFD" FontSize="15" Click="Enter_Click"/>
          <TextBlock Text="SECURE DEVICE MONITORING  •  LIVE TELEMETRY  •  ACTIONABLE INSIGHTS" Foreground="#7489A5" FontSize="10" Margin="0,38,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Column="1" Margin="15,60,60,60">
          <Border Background="#172A43" CornerRadius="28" BorderBrush="#2A4261" BorderThickness="1" Padding="24">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Fill="#39D98A" Margin="0,0,8,0"/>
                <TextBlock Text="SYSTEM OVERVIEW" Foreground="#AFC1D8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="  •  DEMO PREVIEW" Foreground="#7389A5" FontSize="10" VerticalAlignment="Center"/>
              </StackPanel>
              <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <Border Background="#203852" CornerRadius="15" Padding="18" Margin="0,0,0,14">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Connected devices" Foreground="#AFC1D8" FontSize="13"/>
                      <TextBlock Text="Device health at a glance" Foreground="White" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="#194C46" CornerRadius="10" Padding="12">
                      <TextBlock Text="LIVE" Foreground="#5EE6B0" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Border>
                  </Grid>
                </Border>
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Border Background="#203852" CornerRadius="13" Padding="17" Margin="0,0,7,0">
                    <StackPanel><TextBlock Text="TELEMETRY" Foreground="#91A8C5" FontSize="11"/><TextBlock Text="Stream health" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Continuous sensor visibility" Foreground="#B3C3D7" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="#203852" CornerRadius="13" Padding="17" Margin="7,0,0,0">
                    <StackPanel><TextBlock Text="COMMANDS" Foreground="#91A8C5" FontSize="11"/><TextBlock Text="Operator control" Foreground="White" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="History and undo support" Foreground="#B3C3D7" FontSize="11" Margin="0,5,0,0"/></StackPanel>
                  </Border>
                </Grid>
                <Border Background="#203852" CornerRadius="13" Padding="18">
                  <StackPanel>
                    <TextBlock Text="AUTOMATED INSIGHTS" Foreground="#91A8C5" FontSize="11" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><Ellipse Width="8" Height="8" Fill="#F6C85F" Margin="0,0,10,0"/><TextBlock Text="Highlight abnormal readings" Foreground="White" FontSize="13"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Ellipse Width="8" Height="8" Fill="#39D98A" Margin="0,0,10,0"/><TextBlock Text="Review device activity and alerts" Foreground="White" FontSize="13"/></StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
              <TextBlock Grid.Row="2" Text="SMART-X  /  IOT OPERATIONS PLATFORM" Foreground="#7187A3" FontSize="10" Margin="2,20,0,0"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- Login screen shown after Enter -->
      <Grid x:Name="LoginPanel" Visibility="Collapsed" Background="#101D30">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="72,40,30,40">
          <Border Background="#246BFD" CornerRadius="12" Width="54" Height="54" HorizontalAlignment="Left" Margin="0,0,0,24">
            <TextBlock Text="S-X" Foreground="White" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="Welcome back." Foreground="White" FontSize="38" FontWeight="Bold"/>
          <TextBlock Text="Sign in to your Smart-X workspace." Foreground="#B5C3D6" FontSize="16" Margin="0,12,0,0"/>
          <TextBlock Text="Your Firebase account securely connects this desktop app to the SmartX API." Foreground="#8EA4C2" FontSize="13" TextWrapping="Wrap" MaxWidth="470" Margin="0,22,0,0" LineHeight="22"/>
          <Button Content="← Back to welcome" Background="Transparent" HorizontalAlignment="Left" Margin="-3,35,0,0" Click="BackToWelcome_Click"/>
        </StackPanel>
        <Border Grid.Column="1" VerticalAlignment="Center" Margin="20,45,65,45" Background="White" CornerRadius="20" Padding="32">
          <StackPanel>
            <TextBlock Text="Sign in" Foreground="#172B4D" FontSize="27" FontWeight="Bold"/>
            <TextBlock Text="Use your Firebase email and password" Foreground="#66758A" FontSize="13" Margin="0,7,0,25"/>
            <TextBlock Text="API base URL" Foreground="#334155" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBox x:Name="LoginApiUrlBox" Text="http://localhost:5234" Margin="0,0,0,15"/>
            <TextBlock Text="Email address" Foreground="#334155" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBox x:Name="LoginEmailBox" Margin="0,0,0,15"/>
            <TextBlock Text="Password" Foreground="#334155" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <PasswordBox x:Name="LoginPasswordBox" Padding="9,7" Margin="3,0,3,18" BorderBrush="#D6DEE8" BorderThickness="1"/>
            <Button Content="Sign in and open workspace  →" Height="44" Margin="0,0,0,8" Click="Login_Click"/>
            <TextBlock x:Name="LoginMessage" Text="Email/Password sign-in must be enabled in Firebase Authentication." Foreground="#66758A" TextWrapping="Wrap" FontSize="12" Margin="2,12,2,0"/>
            <TextBlock Text="Firebase project: smar-auth" Foreground="#8A97A8" FontSize="11" Margin="2,14,2,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
</Window>